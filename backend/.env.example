# Variables de entorno de la API (.NET las lee con doble guion bajo como separador).
# En Azure App Service van en Configuración > Variables de entorno; la llave en Key Vault.

ASPNETCORE_ENVIRONMENT=Production

# SqlServer (Azure SQL) o Sqlite (solo desarrollo)
BaseDatos__Proveedor=SqlServer
BaseDatos__AplicarMigraciones=false
ConnectionStrings__LineaEtica=Server=tcp:<servidor>.database.windows.net,1433;Database=LineaEtica;Authentication=Active Directory Default;Encrypt=True;

# Llave AES-256 en base64 (32 bytes). Generar con scripts/generar-llave.sh. NUNCA subirla al repositorio.
# Si se pierde, no se pueden leer las denuncias guardadas.
Cifrado__Llave=

# Parámetros pendientes de definición jurídica
Canal__RetencionDiasTrasCierre=365
Canal__PlazoRespuestaDias=15
Canal__TextoAcuse=Hemos recibido su denuncia. Guarde su código y contraseña para consultar el estado del caso y comunicarse con nosotros.

# Primera carga (solo se usa si la base está vacía)
Semilla__Empresas__0=Londoño Gómez
Semilla__Oficial__Nombre=
Semilla__Oficial__Correo=
Semilla__Oficial__Clave=
