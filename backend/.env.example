# Referencia de las variables de la API. ASP.NET no lee archivos .env:
# - En desarrollo, la cadena de conexión se guarda con dotnet user-secrets (fuera del repo).
# - En Azure, estas variables van en la configuración del App Service o en Key Vault.
# Los plazos y textos no van aquí: viven en las tablas Configuracion y TextosLegales.

ConnectionStrings__LineaEtica=Server=tcp:<servidor>.database.windows.net,1433;Database=<base>;User ID=<usuario>;Password=<contraseña>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;

# Llave AES-256 en base64 (32 bytes). NUNCA subirla al repositorio.
# Si se pierde, no se pueden leer las denuncias guardadas.
Cifrado__Llave=

# Primer oficial de cumplimiento: solo se crea si la base no tiene gestores. La clave es temporal
# (mínimo 12 caracteres): al entrar debe cambiarla y registrar el TOTP. Después se puede borrar de aquí.
Semilla__Oficial__Nombre=
Semilla__Oficial__Correo=
Semilla__Oficial__Clave=
